{
  "name": "liquidcss",
  "version": "0.0.1",
  "description": "Utility-first CSS framework for interactive Liquid Glass surfaces (refraction, angle sheens, hover shine, ripple).",
  "type": "module",
  "license": "MIT",
  "keywords": ["css", "utility-first", "liquid-glass", "glassmorphism", "backdrop-filter", "svg-filter", "refraction"],
  "repository": { "type": "git", "url": "git+https://github.com/liquidcss/liquidcss.git", "directory": "packages/core" },
  "homepage": "https://github.com/liquidcss/liquidcss#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./theme.default.css",
    "./filters.svg": "./assets/liquidcss-filters.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.default.css",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "gen:filters": "node scripts/gen-filters.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "lightningcss": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "@ferdintel/liquidcss-postcss",
  "version": "0.0.2",
  "description": "PostCSS plugin for LiquidCSS — replaces @liquidcss theme; and @liquidcss utilities; with the compiled Liquid Glass CSS.",
  "type": "module",
  "license": "MIT",
  "author": "ferdintel",
  "keywords": [
    "css",
    "postcss-plugin",
    "liquid-glass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdintel/liquidcss.git",
    "directory": "packages/postcss-plugin"
  },
  "homepage": "https://github.com/ferdintel/liquidcss#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "dependencies": {
    "@ferdintel/liquidcss": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "postcss": "^8.4.47",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
